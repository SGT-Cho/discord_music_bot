# Required for local Discord execution
DISCORD_TOKEN="your_discord_bot_token_here"

# Optional: used for Spotify metadata resolution
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"

# Optional: bot message language — "en" (default) or "ko"
# BOT_LANGUAGE="en"

# Optional: audio cache directory (default: cache/audio)
# AUDIO_CACHE_DIR="cache/audio"

# Optional: channel ID for operational notifications (cache failures, yt-dlp
# trouble). Playback errors users can see always go to the music channel; these
# are the ones only an operator can act on. Leave unset to keep them in the
# logs only.
# OPS_CHANNEL_ID="123456789012345678"

# Optional: override the deployed image (default: the published :latest tag).
# Pin a specific tag to roll back, e.g. ghcr.io/sgt-cho/discord_music_bot:ytdlp-2026.08.18.122307
# BOT_IMAGE="ghcr.io/sgt-cho/discord_music_bot:latest"
