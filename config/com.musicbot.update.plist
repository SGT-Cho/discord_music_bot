<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job that runs bin/update.sh at 00:00/06:00/12:00/18:00 local time.

  launchd rather than cron because this runs on a laptop: if the machine is
  asleep at the scheduled time, launchd runs the job once on wake instead of
  skipping the window entirely.

  Install (edit the two paths first — launchd does not expand ~ or $HOME):

    cp config/com.musicbot.update.plist ~/Library/LaunchAgents/
    launchctl bootstrap user/$(id -u) ~/Library/LaunchAgents/com.musicbot.update.plist

  Check on it:

    launchctl list | grep musicbot
    tail -f ~/Library/Logs/musicbot-update.log

  Remove:

    launchctl bootout user/$(id -u)/com.musicbot.update
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.musicbot.update</string>

    <!-- This Mac is administered through a headless SSH/background login,
         so there is no gui/<uid> launchd domain. -->
    <key>LimitLoadToSessionType</key>
    <string>Background</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/bin/bash</string>
        <!-- Absolute path to your checkout; launchd does not expand ~ or $HOME. -->
        <string>/Users/winter/Documents/discord-bot/music-bot/bin/update.sh</string>
    </array>

    <!-- Docker Desktop puts the `docker` CLI here; launchd jobs start with a
         minimal PATH that does not include it. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/winter</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>DOCKER_CONFIG</key>
        <string>/Users/winter/.docker</string>
        <key>DOCKER_CONTEXT</key>
        <string>colima</string>
        <key>LC_ALL</key>
        <string>C</string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <!-- Do not fire during the boot storm; the first check can wait. -->
    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/winter/Library/Logs/musicbot-update.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/winter/Library/Logs/musicbot-update.log</string>
</dict>
</plist>
